<Window x:Class="RadeonLLM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wraith" Width="980" Height="720" MinWidth="820" MinHeight="600"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="18,10" Background="{StaticResource Bg}">
        <DockPanel>
            <Border x:Name="ChipBorder" DockPanel.Dock="Right" BorderBrush="{StaticResource Fg}" BorderThickness="1" Padding="10,1" VerticalAlignment="Center">
                <TextBlock x:Name="ChipText" Text="● STOPPED"/>
            </Border>
            <TextBlock DockPanel.Dock="Left" Text="WRAITH" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Hi}" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Left" Text=" v0.2" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
            <TextBlock Text="1-5 switch tab" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
        </DockPanel>
    </Border>
    <TabControl x:Name="Tabs" Grid.Row="1" Background="{StaticResource Bg}" BorderThickness="0" Padding="0">

        <!-- HOME -->
        <TabItem Header="1:status">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="900" HorizontalAlignment="Left">

                    <Border x:Name="SetupPanel" Style="{StaticResource Card}" Visibility="Collapsed" BorderBrush="{StaticResource Hi}">
                        <StackPanel>
                            <TextBlock Text="RUNTIME NOT INSTALLED" Foreground="{StaticResource Hi}" FontWeight="Bold"/>
                            <TextBlock Style="{StaticResource Muted}" Text="Downloads the validated llama.cpp runtime for your hardware (one time)." Margin="0,4,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SetupBtn" Content="SETUP" Click="Setup_Click" Style="{StaticResource Primary}" Padding="28,6" FontSize="14"/>
                            </StackPanel>
                            <TextBlock x:Name="SetupStage" Style="{StaticResource Value}" Margin="0,10,0,4" Visibility="Collapsed"/>
                            <ProgressBar x:Name="SetupBar" Maximum="1" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="SPEED" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="KpiTps" Text="0.0" Style="{StaticResource Big}"/><TextBlock Text=" tok/s" VerticalAlignment="Bottom" Margin="0,0,0,4"/></StackPanel></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="GPU LOAD" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="KpiGpu" Text="0" Style="{StaticResource Big}"/><TextBlock Text=" %" VerticalAlignment="Bottom" Margin="0,0,0,4"/></StackPanel></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="VRAM" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="KpiVram" Text="0.0" Style="{StaticResource Big}"/><TextBlock x:Name="KpiVramUnit" Text=" GB" VerticalAlignment="Bottom" Margin="0,0,0,4"/></StackPanel></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="POWER" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="KpiPower" Text="n/a" Style="{StaticResource Big}"/><TextBlock Text=" W" VerticalAlignment="Bottom" Margin="0,0,0,4"/></StackPanel></StackPanel></Border>
                    </UniformGrid>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="SYSTEM" Foreground="{StaticResource Hi}" FontSize="12" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="gpu        " Style="{StaticResource Muted}"/><TextBlock x:Name="GpuText" Grid.Column="1" Style="{StaticResource Value}"/>
                                    <TextBlock Grid.Row="1" Text="backend    " Style="{StaticResource Muted}"/><TextBlock x:Name="VulkanText" Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}"/>
                                    <TextBlock Grid.Row="2" Text="model      " Style="{StaticResource Muted}"/><TextBlock x:Name="ModelText" Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}"/>
                                    <TextBlock Grid.Row="3" Text="preflight  " Style="{StaticResource Muted}"/><TextBlock x:Name="PreflightText" Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="SERVER" Foreground="{StaticResource Hi}" FontSize="12" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ApiDot" Text="●" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="ApiText" Style="{StaticResource Value}"/>
                                </StackPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="RunBtn" Content="RUN" Click="Run_Click" Style="{StaticResource Primary}"/>
                                    <Button Content="copy endpoint" Click="CopyEndpoint_Click" VerticalAlignment="Center"/>
                                    <Button Content="chat" Click="OpenChat_Click" VerticalAlignment="Center"/>
                                    <Button Content="benchmark" Click="GoBenchmark_Click" VerticalAlignment="Center"/>
                                </WrapPanel>
                                <TextBlock x:Name="StatusText" Margin="0,8,0,0" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="ErrorPanel" Style="{StaticResource Card}" BorderBrush="{StaticResource Hi}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ErrorTitle" FontWeight="Bold" Foreground="{StaticResource Hi}"/>
                            <TextBlock x:Name="ErrorCauses" Style="{StaticResource Muted}" Margin="0,6,0,8"/>
                            <WrapPanel x:Name="ErrorActions"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="LIVE" Foreground="{StaticResource Hi}" FontSize="12" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                <TextBlock Text="gpu"/><ProgressBar x:Name="GaugeGpu" Grid.Column="1" VerticalAlignment="Center"/><TextBlock x:Name="TxtGpu" Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Value}"/>
                                <TextBlock Grid.Row="1" Text="vram"/><ProgressBar x:Name="GaugeVram" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/><TextBlock x:Name="TxtVram" Grid.Row="1" Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Value}"/>
                                <TextBlock Grid.Row="2" Text="speed"/><ProgressBar x:Name="GaugeTps" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/><TextBlock x:Name="TxtTps" Grid.Row="2" Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Value}"/>
                                <TextBlock Grid.Row="3" Text="power"/><ProgressBar x:Name="GaugePower" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"/><TextBlock x:Name="TxtPower" Grid.Row="3" Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Value}"/>
                                <TextBlock Grid.Row="4" Text="temp"/><ProgressBar x:Name="GaugeTemp" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"/><TextBlock x:Name="TxtTemp" Grid.Row="4" Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Value}"/>
                                <TextBlock Grid.Row="5" Text="hotspot"/><ProgressBar x:Name="GaugeHot" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center"/><TextBlock x:Name="TxtHot" Grid.Row="5" Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Value}"/>
                            </Grid>
                            <TextBlock x:Name="ClockText" Margin="0,8,0,0" Style="{StaticResource Value}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- MODELS -->
        <TabItem Header="2:models">
            <Grid Margin="32,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Installed Models" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                <ListBox x:Name="ModelList" Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding ApiId}" Style="{StaticResource Muted}" FontFamily="Consolas"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Verdict}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                    <Button Content="Add Model" Click="AddModel_Click"/>
                    <Button Content="Download Model" Click="DownloadModel_Click"/>
                    <Button Content="Set Default" Click="SetDefault_Click"/>
                    <Button Content="Rename" Click="Rename_Click"/>
                    <Button Content="Verify" Click="VerifyModel_Click"/>
                    <Button Content="Remove" Click="RemoveModel_Click"/>
                    <TextBlock x:Name="ModelsStatus" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="ModelsBar" Width="160" Maximum="1" Visibility="Collapsed" Margin="12,0,0,0"/>
                </WrapPanel>
            </Grid>
        </TabItem>

        <!-- CHAT -->
        <TabItem Header="3:chat">
            <Grid Margin="32,20">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBox x:Name="ChatLog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{StaticResource Panel}"
                         FontSize="14" Padding="12"/>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ChatInput" AcceptsReturn="True" MaxHeight="120" TextWrapping="Wrap" FontSize="14" KeyDown="ChatInput_KeyDown"/>
                    <Button x:Name="ChatSend" Grid.Column="1" Content="Send" Click="ChatSend_Click" Margin="8,0,0,0" Style="{StaticResource Primary}" Padding="22,8" FontSize="14"/>
                </Grid>
                <TextBlock x:Name="ChatStatus" Grid.Row="2" Style="{StaticResource Muted}" Margin="0,6,0,0"
                           Text="Uses the same OpenAI-compatible API as external apps. Enter to send, Shift+Enter for newline."/>
            </Grid>
        </TabItem>

        <!-- PERFORMANCE -->
        <TabItem Header="4:perf">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,20" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="CURRENT SESSION" Style="{StaticResource H}" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource Card}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="SessionLabels" LineHeight="22" Margin="0,0,16,0" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="SessionValues" Grid.Column="1" LineHeight="22" Style="{StaticResource Value}"/>
                    </Grid></Border>

                    <TextBlock Text="ALL-TIME API" Style="{StaticResource H}"/>
                    <Border Style="{StaticResource Card}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ApiLabels" LineHeight="22" Margin="0,0,16,0" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="ApiValues" Grid.Column="1" LineHeight="22" Style="{StaticResource Value}"/>
                    </Grid></Border>

                    <TextBlock Text="BENCHMARK" Style="{StaticResource H}"/>
                    <TextBlock Style="{StaticResource Muted}" Text="3 iterations, ~128 prompt tokens, 1024 generated tokens, fixed seed. Requires a running server."/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="BenchBtn" Content="Run Benchmark" Click="Benchmark_Click"/>
                        <TextBox x:Name="BenchLabel" Width="200" ToolTip="Optional label, e.g. 'UV -75mV'"/>
                    </StackPanel>
                    <TextBlock x:Name="BenchText" Style="{StaticResource Value}" FontFamily="Consolas" FontSize="14" LineHeight="22" Margin="0,8,0,0"/>

                    <TextBlock Text="BATCH TUNING" Style="{StaticResource H}"/>
                    <TextBlock Style="{StaticResource Muted}" Text="Tries several batch sizes with a long prompt (restarts the server several times) and saves the fastest as a Custom profile."/>
                    <Button x:Name="TuneBtn" Content="Tune Batch Size" Click="Tune_Click" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TuneText" Style="{StaticResource Value}" FontFamily="Consolas" FontSize="13" LineHeight="20" Margin="0,8,0,0"/>

                    <TextBlock Text="HISTORY" Style="{StaticResource H}"/>
                    <TextBlock x:Name="HistoryText" Style="{StaticResource Value}" FontFamily="Consolas" FontSize="13" LineHeight="20"/>

                    <TextBlock Text="STABILITY TEST" Style="{StaticResource H}"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="StressDuration" Width="120" Margin="0,0,8,0" SelectedIndex="0">
                            <ComboBoxItem Content="5 minutes" Tag="5"/>
                            <ComboBoxItem Content="30 minutes" Tag="30"/>
                            <ComboBoxItem Content="1 hour" Tag="60"/>
                            <ComboBoxItem Content="1 minute (quick)" Tag="1"/>
                        </ComboBox>
                        <Button x:Name="StressBtn" Content="Start Stress Test" Click="Stress_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="StressText" Style="{StaticResource Value}" FontFamily="Consolas" FontSize="14" LineHeight="22" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- SETTINGS -->
        <TabItem Header="5:config">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,20" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Inference" FontSize="20" FontWeight="Bold"/>

                    <TextBlock Text="Performance Profile" Style="{StaticResource H}"/>
                    <ComboBox x:Name="ProfileBox" SelectionChanged="Settings_Changed" Width="200" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Safe"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Maximum"/><ComboBoxItem Content="Custom"/>
                    </ComboBox>
                    <StackPanel x:Name="CustomPanel" Visibility="Collapsed">
                        <TextBlock Text="Context (tokens)" Style="{StaticResource H}"/>
                        <TextBox x:Name="CtxBox" Width="120" HorizontalAlignment="Left" LostFocus="Settings_Changed"/>
                        <TextBlock Text="GPU layers (-1 = automatic maximum)" Style="{StaticResource H}"/>
                        <TextBox x:Name="NglBox" Width="120" HorizontalAlignment="Left" LostFocus="Settings_Changed"/>
                        <CheckBox x:Name="FaBox" Content="Flash Attention" Click="Settings_Changed" Margin="0,8,0,0"/>
                        <TextBlock Text="KV cache (q8_0 needs Flash Attention)" Style="{StaticResource H}"/>
                        <ComboBox x:Name="KvBox" SelectionChanged="Settings_Changed" Width="120" HorizontalAlignment="Left">
                            <ComboBoxItem Content="f16"/><ComboBoxItem Content="q8_0"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="PlanText" Style="{StaticResource Muted}" Margin="0,8,0,0"/>

                    <TextBlock Text="API SERVER" Style="{StaticResource H}"/>
                    <CheckBox x:Name="ApiEnabledBox" Content="API server enabled" Click="Settings_Changed"/>
                    <TextBlock Text="Port" Style="{StaticResource H}"/>
                    <TextBox x:Name="PortBox" Width="100" HorizontalAlignment="Left" LostFocus="Settings_Changed"/>
                    <TextBlock Text="Network Access" Style="{StaticResource H}"/>
                    <RadioButton x:Name="LocalOnlyRadio" Content="Localhost only" Foreground="{StaticResource Fg}" Click="Network_Click" GroupName="net"/>
                    <RadioButton x:Name="LanRadio" Content="Local network (requires API key)" Foreground="{StaticResource Fg}" Click="Network_Click" GroupName="net" Margin="0,4,0,0"/>
                    <TextBlock x:Name="LanText" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    <CheckBox x:Name="LocalKeyBox" Content="Also require API key on localhost" Click="Settings_Changed" Margin="0,8,0,0"/>
                    <TextBlock Text="API Key" Style="{StaticResource H}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="KeyBox" Width="340" IsReadOnly="True" Margin="0,0,8,0"/>
                        <Button x:Name="KeyShowBtn" Content="Show" Click="KeyShow_Click"/>
                        <Button Content="Copy" Click="KeyCopy_Click"/>
                        <Button Content="Regenerate" Click="KeyRegen_Click"/>
                    </StackPanel>

                    <TextBlock Text="NETWORK" Style="{StaticResource H}"/>
                    <CheckBox x:Name="OfflineBox" Content="Offline Mode (blocks downloads; localhost API keeps working)" Click="Settings_Changed"/>

                    <TextBlock Text="RUNTIME" Style="{StaticResource H}"/>
                    <TextBlock x:Name="RuntimeText"/>
                    <TextBlock Text="Backend" Style="{StaticResource H}"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="BackendBox" Width="200" Margin="0,0,8,0">
                            <ComboBoxItem Content="Auto (recommended)"/><ComboBoxItem Content="Vulkan (AMD / NVIDIA / Intel)"/>
                            <ComboBoxItem Content="CUDA (NVIDIA)"/><ComboBoxItem Content="ROCm / HIP (recent AMD)"/><ComboBoxItem Content="CPU only"/>
                        </ComboBox>
                        <Button Content="Install / Switch Backend" Click="BackendApply_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="BackendHint" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Check for Update" Click="RtCheck_Click"/>
                        <Button x:Name="RtUpdateBtn" Content="Update" Click="RtUpdate_Click" Visibility="Collapsed"/>
                        <Button x:Name="RtIgnoreBtn" Content="Ignore" Click="RtIgnore_Click" Visibility="Collapsed"/>
                        <Button Content="Verify" Click="RtVerify_Click"/>
                        <Button Content="Repair" Click="RtRepair_Click"/>
                        <Button Content="Rollback" Click="RtRollback_Click"/>
                        <Button Content="Remove" Click="RtRemove_Click"/>
                    </WrapPanel>
                    <ProgressBar x:Name="RtBar" Maximum="1" Visibility="Collapsed" Margin="0,8,0,0"/>
                    <TextBlock x:Name="RtStatus" Style="{StaticResource Muted}" Margin="0,4,0,0"/>

                    <TextBlock Text="DIAGNOSTICS" Style="{StaticResource H}"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="LogBox" Width="160" SelectedIndex="0" SelectionChanged="LogBox_Changed" Margin="0,0,8,0">
                            <ComboBoxItem Content="app"/><ComboBoxItem Content="runtime"/><ComboBoxItem Content="inference"/><ComboBoxItem Content="api"/>
                        </ComboBox>
                        <Button Content="Refresh" Click="LogRefresh_Click"/>
                        <Button Content="Open Logs Folder" Click="OpenLogs_Click"/>
                        <Button Content="Open Data Folder" Click="OpenData_Click"/>
                    </StackPanel>
                    <TextBox x:Name="LogView" Height="220" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Margin="0,8,0,24"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
    </Grid>
</Window>
