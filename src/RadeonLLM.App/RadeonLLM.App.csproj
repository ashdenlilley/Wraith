<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>RadeonLLM</AssemblyName>
    <RootNamespace>RadeonLLM.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\RadeonLLM.Core\RadeonLLM.Core.csproj" />
    <ProjectReference Include="..\RadeonLLM.Hardware\RadeonLLM.Hardware.csproj" />
    <ProjectReference Include="..\RadeonLLM.Runtime\RadeonLLM.Runtime.csproj" />
    <ProjectReference Include="..\RadeonLLM.Models\RadeonLLM.Models.csproj" />
    <ProjectReference Include="..\RadeonLLM.Inference\RadeonLLM.Inference.csproj" />
    <ProjectReference Include="..\RadeonLLM.Analytics\RadeonLLM.Analytics.csproj" />
    <ProjectReference Include="..\RadeonLLM.Api\RadeonLLM.Api.csproj" />
    <ProjectReference Include="..\RadeonLLM.Security\RadeonLLM.Security.csproj" />
  </ItemGroup>
</Project>
